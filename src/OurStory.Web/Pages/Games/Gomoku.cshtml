@page "/games/gomoku"
@model OurStory.Web.Pages.Games.GomokuModel
@{
    ViewData["Title"] = "五子棋 · 一起玩";
    ViewData["ActiveNav"] = "games";
    ViewData["Bundle"] = "games";
}
<main id="main" class="games-page gomoku-page" data-gomoku>
    <a class="games-back" href="/games">@Icon("arrow-left") 全部小游戏</a>
    <header class="gomoku-heading"><div><p class="games-eyebrow">A MATCH FOR TWO</p><h1>五子棋</h1></div><span class="game-badge">@Icon("lock") 在线双人</span></header>
    <noscript><p class="game-error">五子棋需要启用 JavaScript 才能落子和同步棋局。</p></noscript>
    <div class="gomoku-layout">
        <section class="gomoku-table" aria-label="五子棋对局">
            <div class="game-status-bar"><span class="turn-stone stone-black" data-turn-stone aria-hidden="true"></span><div><h2 data-status role="status" aria-live="polite">正在连接棋局…</h2><p data-status-hint>正在读取你们的对局记录</p></div><span class="move-count" data-move-count>0 手</span></div>
            <div class="board-frame">
                <div class="gomoku-board" role="group" aria-label="15 行 15 列五子棋盘，方向键移动，回车或空格落子" aria-busy="true" data-board></div>
            </div>
            <div class="board-caption"><span>15 × 15 · 自由五子棋</span><span data-last-move>黑棋先行</span></div>
        </section>
        <aside class="game-sidebar">
            <section class="game-panel">
                <p class="games-eyebrow">JUST THE TWO OF US</p><h2>你和对方的棋局</h2>
                <div class="player-row"><span class="player-stone" data-my-stone aria-hidden="true"></span><div><strong>我</strong><small data-my-color>开局后分配棋色</small></div></div>
                <div class="player-row"><span class="player-stone" data-partner-stone aria-hidden="true"></span><div><strong>对方</strong><small data-partner-color>在另一台设备上加入</small></div></div>
                <p class="game-connection" data-connection role="status">正在连接…</p>
                <p class="game-error" data-error role="alert" hidden></p>
                <div class="game-actions">
                    <button type="button" class="game-button primary" data-start disabled>开始一局</button>
                    <button type="button" class="game-button" data-resign disabled>认输</button>
                    <button type="button" class="game-button" data-refresh>刷新棋局</button>
                    <button type="button" class="game-button" data-invite>复制对局链接</button>
                </div>
                <p class="game-help">让对方用自己的账号打开此页面，即可进入同一盘棋。首次开局者执黑，再来一局时交换先手。</p>
                <a class="game-login" href="/login?ReturnUrl=%2Fgames%2Fgomoku" data-login hidden>重新登录，继续下棋 @Icon("arrow-right")</a>
            </section>
            <section class="game-panel game-rules"><h2>落子之前</h2><ol><li>黑棋先行，双方轮流在交叉点落子。</li><li>横、竖或斜向连续五子及以上获胜，不设禁手。</li><li>落子后不可悔棋；棋盘落满且无人获胜则和棋。</li></ol><p>棋局自动保存。暂时离开或刷新页面，再回来继续这一局。</p></section>
        </aside>
    </div>
    <div hidden>@Html.AntiForgeryToken()</div>
</main>
